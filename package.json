{
	"name": "@the-sumeet/sveltedown",
	"version": "1.2.0",
	"description": "A live-preview Markdown editor for Svelte 5, built on CodeMirror 6.",
	"keywords": [
		"svelte"
	],
	"license": "MIT",
	"author": "Sumeet",
	"homepage": "https://the-sumeet.github.io/sveltedown/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/the-sumeet/sveltedown.git"
	},
	"bugs": {
		"url": "https://github.com/the-sumeet/sveltedown/issues"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepack": "npm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"docs:dev": "npm --prefix docs run dev",
		"docs:build": "npm --prefix docs run build",
		"docs:check": "npm --prefix docs run check"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./editor.css": "./dist/styles/editor.css"
	},
	"peerDependencies": {
		"svelte": "^5.40.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@radix-ui/colors": "^3.0.0",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/js-yaml": "^4.0.9",
		"@types/mdast": "^4.0.4",
		"@types/node": "^24",
		"@types/unist": "^3.0.3",
		"@vitest/browser-playwright": "^4.1.8",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"micromark-util-types": "^2.0.3",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"publint": "^0.3.21",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/language": "^6.13.1",
		"@codemirror/language-data": "^6.5.2",
		"@codemirror/merge": "^6.12.3",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@lexical/clipboard": "^0.53.0",
		"@lexical/dragon": "^0.53.0",
		"@lexical/extension": "^0.53.0",
		"@lexical/history": "^0.53.0",
		"@lexical/link": "^0.53.0",
		"@lexical/list": "^0.53.0",
		"@lexical/markdown": "^0.53.0",
		"@lexical/plain-text": "^0.53.0",
		"@lexical/rich-text": "^0.53.0",
		"@lexical/selection": "^0.53.0",
		"@lexical/text": "^0.53.0",
		"@lexical/utils": "^0.53.0",
		"@lezer/highlight": "^1.2.5",
		"bits-ui": "^2.20.6",
		"codemirror": "^6.0.2",
		"js-yaml": "^4.3.2",
		"lexical": "^0.53.0",
		"mdast-util-directive": "^3.2.0",
		"mdast-util-from-markdown": "^2.1.0",
		"mdast-util-frontmatter": "^2.0.1",
		"mdast-util-gfm-strikethrough": "^2.0.1",
		"mdast-util-gfm-table": "^2.0.1",
		"mdast-util-gfm-task-list-item": "^2.0.0",
		"mdast-util-highlight-mark": "^1.2.2",
		"mdast-util-mdx": "^3.0.0",
		"mdast-util-mdx-jsx": "^3.2.1",
		"mdast-util-to-markdown": "^2.2.2",
		"micromark-extension-directive": "^3.0.2",
		"micromark-extension-frontmatter": "^2.0.0",
		"micromark-extension-gfm-strikethrough": "^2.1.0",
		"micromark-extension-gfm-table": "^2.1.2",
		"micromark-extension-gfm-task-list-item": "^2.1.0",
		"micromark-extension-highlight-mark": "^1.2.0",
		"micromark-extension-mdx-jsx": "^3.0.2",
		"micromark-extension-mdx-md": "^2.0.0",
		"micromark-extension-mdxjs": "^3.0.0",
		"micromark-factory-space": "^2.1.0",
		"micromark-util-character": "^2.1.1",
		"micromark-util-symbol": "^2.0.1"
	}
}
